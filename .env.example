# Copy to .env and fill in. .env is gitignored; this file is committed and holds placeholders only.
# `docker compose up` works without a .env: every value below has a default.

# Postgres. The database is not exposed outside the Docker network, so the default
# password only matters if you publish the port. Change it if you do.
PKOS_DB_PASSWORD=pkos-local-dev

# Logging: DEBUG, INFO, WARNING. Secrets are scrubbed at every level.
PKOS_LOG_LEVEL=INFO

# Added in later steps (left blank until then):
# PKOS_GRANOLA_API_KEY=
# PKOS_HOSTED_API_KEY=
